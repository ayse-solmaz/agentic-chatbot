# Copy this file to .env and fill in your own keys.
# Never commit the real .env file.

# LLM and embeddings (required)
OPENAI_API_KEY=

# Tools (stage 4 and later)
TAVILY_API_KEY=
OPENWEATHER_API_KEY=
ALPHAVANTAGE_API_KEY=

# LangSmith tracing and evaluation (optional)
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=agentic-chatbot
